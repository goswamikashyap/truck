# Copy to server/.env and change the secrets.
# For running the server directly on your laptop (npm run dev), the DB host is localhost.
# docker-compose overrides DATABASE_URL to use the "db" service automatically.
DATABASE_URL="postgresql://saas:saas@localhost:5432/transport?schema=public"
JWT_ACCESS_SECRET="change-me-short-lived-at-least-32-characters"
JWT_REFRESH_SECRET="change-me-long-lived-at-least-32-characters"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Optional, used in later phases (bills / LR / POD uploads)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET=
