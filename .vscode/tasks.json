{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "db: start Postgres",
      "type": "shell",
      "command": "docker compose up -d db"
    },
    {
      "label": "server: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/server" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "client: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/client" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev: everything",
      "dependsOn": ["db: start Postgres", "server: dev", "client: dev"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "server: test",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/server" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
